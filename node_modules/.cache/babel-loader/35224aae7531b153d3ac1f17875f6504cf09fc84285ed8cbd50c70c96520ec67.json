SmilesProvider = ({children}) => {\r\n    const [smiles, setSmiles] = useState(() => {\r\n        const stored = localStorage.getItem('votes');\r\n        return stored ? JSON.parse(stored) : initialSmiles;\r\n    });\r\n    const [winner, setWinner] = useState(null);\r\n\r\n    useEffect(() => {\r\n        localStorage.setItem('votes', JSON.stringify(smiles));\r\n    }, [smiles]);\r\n\r\n    const handleVote = (id) => {\r\n        setSmiles((prev) =>\r\n            prev.map((smile) =>\r\n                smile.id === id ? {...smile, votes: smile.votes + 1} : smile\r\n            )\r\n        );\r\n    };\r\n\r\n    const showResult = () => {\r\n        const top = smiles.reduce((max, s) => (s.votes > max.votes ? s : max), smiles[0]);\r\n        setWinner(top);\r\n    };\r\n\r\n    const resetVotes = () => {\r\n        setSmiles(initialSmiles);\r\n        setWinner(null);\r\n        localStorage.removeItem('votes');\r\n    };\r\n\r\n    return (\r\n        <SmilesContext.Provider value={{smiles, handleVote, winner, showResult, resetVotes}}>\r\n            {children}\r\n        </SmilesContext.Provider>\r\n    );\r\n};"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAGC,aAAa,CAAEC,QAAQ,CAAEC,UAAU,CAAEC,SAAS,KAAO,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,yBAE5E,KAAM,CAAAC,aAAa,cAAGN,aAAa,CAAC,CAAC,CAErC,MAAO,MAAM,CAAAO,SAAS,CAAGA,CAAA,GAAML,UAAU,CAACI,aAAa,CAAC,CAExD,KAAM,CAAAE,aAAa,CAAG,CAClB,CAACC,EAAE,CAAE,CAAC,CAAEC,KAAK,CAAE,IAAI,CAAEC,KAAK,CAAE,CAAC,CAAC,CAC9B,CAACF,EAAE,CAAE,CAAC,CAAEC,KAAK,CAAE,IAAI,CAAEC,KAAK,CAAE,CAAC,CAAC,CAC9B,CAACF,EAAE,CAAE,CAAC,CAAEC,KAAK,CAAE,IAAI,CAAEC,KAAK,CAAE,CAAC,CAAC,CAC9B,CAACF,EAAE,CAAE,CAAC,CAAEC,KAAK,CAAE,IAAI,CAAEC,KAAK,CAAE,CAAC,CAAC,CACjC,CAED,MAAO,MAAM,CAAAC,cAAc,CAAGC,IAAA,EAAgB,IAAf,CAACC,QAAQ,CAAC,CAAAD,IAAA,CACrC,KAAM,CAACE,MAAM,CAAEC,SAAS,CAAC,CAAGf,QAAQ,CAAC,IAAM,CACvC,KAAM,CAAAgB,MAAM,CAAGC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,CAC5C,MAAO,CAAAF,MAAM,CAAGG,IAAI,CAACC,KAAK,CAACJ,MAAM,CAAC,CAAGT,aAAa,CACtD,CAAC,CAAC,CACF,KAAM,CAACc,MAAM,CAAEC,SAA